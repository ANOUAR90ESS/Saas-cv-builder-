# Copy to .env.local and fill in. Every name here is PUBLIC: Vite compiles
# VITE_ values into the JavaScript bundle, which is served to every visitor
# and packed into the Android APK. Never put a secret behind a VITE_ prefix.
#
# Firebase's web config is public by design. It identifies the project; what
# a caller may actually do is decided by Firebase Auth and the rules in
# firestore.rules, not by knowing these strings.
#
# Where to find them: Firebase Console -> Project settings -> General ->
# "Your apps" -> the web app -> SDK setup and configuration -> Config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Leave blank to use the project's default Firestore database; set it
# only if you created a named one.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# ---------------------------------------------------------------------------
# Server only. These are read by server.ts through process.env and are never
# compiled into the bundle. They belong in the host's environment settings,
# not in a file the frontend build can see.
# ---------------------------------------------------------------------------

# Same project as VITE_FIREBASE_PROJECT_ID above. Used by firebase-admin to
# verify the ID tokens that requireAuth checks.
FIREBASE_PROJECT_ID=your-project

# Google AI Studio key for the /api/functions/ai-assist routes. Without it
# those routes answer 503 and the rest of the app still works.
GEMINI_API_KEY=

# Cloud SQL / Postgres, used by the /api/cvs and /api/user/sync routes.
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# ---------------------------------------------------------------------------
# Guards for the AI routes, which have no sign-in in front of them by design.
# All optional: unset means the default in the second column.
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call /api/functions from a browser.
# Requests from the origin the app is served on are always allowed, so this is
# for anything else. Unset means no origin is refused, and the server says so
# on startup.
ALLOWED_ORIGINS=https://dexacv.com

# Calls per address per window, and the window. Default 30 per 10 minutes.
AI_RATE_LIMIT=30
AI_RATE_WINDOW_MINUTES=10

# Largest accepted body, in kB. Cost scales with input length. Default 64.
AI_MAX_BODY_KB=64

# Set when the server sits behind a proxy that adds X-Forwarded-For (Vercel, a
# load balancer, Cloudflare). Without it every visitor shares the proxy's
# address and one busy user rate-limits everyone. Express syntax: "1" trusts
# one hop, or a subnet.
TRUST_PROXY=1
