rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 254 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    function isValidCv(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 150 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (!('data' in data) || data.data is map);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (resource == null || request.auth.uid == userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
                    incoming().id == userId &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
                    incoming().id == userId &&
                    (!('createdAt' in incoming()) || incoming().createdAt == resource.data.createdAt || incoming().createdAt == request.time) &&
                    incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /cvs/{cvId} {
      allow get: if isSignedIn() && isValidId(cvId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(cvId) && isValidCv(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(cvId) && isValidCv(incoming()) &&
                    resource.data.userId == request.auth.uid &&
                    incoming().userId == resource.data.userId &&
                    (!('createdAt' in resource.data) || incoming().createdAt == resource.data.createdAt || incoming().createdAt == request.time) &&
                    incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && isValidId(cvId) && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /career_profiles/{profileId} {
      allow get: if (resource != null && resource.data.isPublished == true) ||
                    (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /job_applications/{appId} {
      allow get, list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /cover_letters/{letterId} {
      allow get, list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /interview_sessions/{sessionId} {
      allow get, list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
